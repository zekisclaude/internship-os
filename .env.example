# Copy to .env.local for local development. On Vercel, set these in Project Settings > Environment Variables.
# Never commit real values.

# Postgres (Neon from the Vercel Marketplace). Leave empty locally to use an in-memory test database.
DATABASE_URL=

# Public URL of the deployment, no trailing slash, e.g. https://internship-os.vercel.app
APP_URL=http://localhost:3000

# Google OAuth client (Google Cloud Console > APIs & Services > Credentials > OAuth client ID, type Web application).
# Authorized redirect URI: <APP_URL>/api/auth/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Only these Google accounts may sign in (comma separated). The first one is the Gmail account emails are sent from.
OWNER_EMAILS=

# Random secrets: generate each with `openssl rand -hex 32`.
SESSION_SECRET=
ENCRYPTION_KEY=
CRON_SECRET=

# Agent API tokens, one per agent. Generate with `openssl rand -hex 32`.
# Give CLAUDE_AGENT_TOKEN to Claude through its secure credential form and CHATGPT_AGENT_TOKEN to ChatGPT (GPT Action auth). Never paste them in chat.
CLAUDE_AGENT_TOKEN=
CHATGPT_AGENT_TOKEN=

# Sending limits
DAILY_SEND_CAP=15
